<div class="aigm-part">
<div class="aigm-header">
  <h3><i class="fa-solid fa-robot"></i> {{localize "AIGM.title"}}</h3>
  <div class="aigm-badges" role="status">
    {{#each badges}}<span class="aigm-badge {{cls}}">{{icon}} {{label}}</span>{{/each}}
  </div>
</div>
{{#if error}}<div class="aigm-error" role="alert">{{error}}</div>{{/if}}
</div>
