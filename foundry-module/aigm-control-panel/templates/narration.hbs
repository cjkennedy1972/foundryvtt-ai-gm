<section class="aigm-section">
  <h4><i class="fa-solid fa-book-open"></i> {{localize "AIGM.section.narration"}}</h4>
  <div class="aigm-narrate-form">
    <textarea name="narration" rows="3" placeholder="{{localize 'AIGM.narrate.placeholder'}}"></textarea>
    <div class="aigm-spatial-options"><label><input type="checkbox" name="includeSpatial" checked> {{localize "AIGM.narrate.spatial"}}</label></div>
    <button type="button" class="aigm-btn aigm-btn-primary aigm-btn-full" data-action="narrate"><i class="fa-solid fa-comment-dots"></i> {{localize "AIGM.button.narrate"}}</button>
  </div>
</section>
