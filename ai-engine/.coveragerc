# Coverage config for the ai-engine test suite.
# Measures SOURCE coverage only (test files, the venv, and the JS admin panel
# are excluded) so the reported percentage reflects application code.
[run]
branch = False
omit =
    tests/*
    test_e2e.py
    .venv/*
    */site-packages/*
    admin-panel/*
    */__init__.py

[report]
show_missing = True
skip_covered = False
# Floor, not a target: keeps coverage from regressing below today's baseline.
# Ratchet upward as each phase adds tests. Started at 45 (baseline 2026-09-15:
# 60.78%; 63.70% after the 2026-09-18 review; 78.93% after the first
# 2026-10-02 review pass added behavioral tests for rules/engine.py,
# immersion/items.py, immersion/particles.py, context/reinforcement_manager.py,
# tts/playback.py, and relay_proc/manager.py; 82.86% after a second pass the
# same day added campaign/story_enricher.py, campaign/orchestrator_assets.py,
# campaign/orchestrator.py, and campaign/obsidian_sync.py — five real bugs
# fixed in total across both passes, each caught by a test that was red
# before the fix and green after.
#
# This number says lines were executed, not that anything was asserted about
# them. A review found three mutants surviving the whole suite — including
# `is_loopback = True` pasted over main.py's fail-closed admin check — while
# coverage sat comfortably above this floor, because tests imported modules
# and echoed constructor arguments back. Raising the floor rewards exactly
# that if it is the only gate, so treat a drop as a signal to look, and never
# treat the number itself as evidence the behaviour is tested. When touching
# something load-bearing, break it on purpose and confirm a test goes red.
fail_under = 80
