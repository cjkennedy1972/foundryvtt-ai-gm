# LLM connection (any OpenAI-compatible endpoint: oMLX, OpenRouter, etc.)
LLM_API_KEY=your-llm-api-key-here
LLM_BASE_URL=http://localhost:8800/v1
MODEL=

# FoundryVTT connection: the engine logs into the world Foundry is serving, as this GM user.
# Create the user in Foundry first (for example "ai-gm" with the GM role).
FOUNDRY_BACKEND=playwright
FOUNDRY_URL=http://localhost:30000
FOUNDRY_USERNAME=
FOUNDRY_PASSWORD=

# Admin Panel
ADMIN_PORT=18080
# Loopback-only by default. To expose the admin API on the LAN, set
# ADMIN_HOST=0.0.0.0 and set ADMIN_TOKEN (then store the same token in the
# admin panel's browser: localStorage key "aigm_admin_token").
ADMIN_HOST=127.0.0.1
ADMIN_TOKEN=
# Add your Foundry origin (scheme://host:port of the page the GM opens) so the in-Foundry
# control panel module can reach this engine, e.g. ...,http://localhost:30000
CORS_ORIGINS=http://localhost:18080,http://127.0.0.1:18080

# Database
SQLITE_DB=foundryvtt-ai-gm.db

# Campaign Data
CAMPAIGN_VAULT_PATH=~/Vaults/MyStuff/Dungeons_and_Dragons

# Folders a source path for campaign lore enrichment may be under (JSON list, ~ expanded).
# Default is your home folder; add others (e.g. an external drive) to enrich from them.
# SOURCE_ROOTS=["~", "/Volumes/Books"]

# How much of the campaign's Worldbuilding note rides in every turn's system prompt;
# the rest, and everything enrichment appends, is retrieved when relevant.
# WORLD_CONTEXT_MAX_TOKENS=6000
# Ceiling on one turn's added context (location, characters in play, memory, lore, maps);
# over it the lowest-priority blocks are dropped and logged.
# TURN_CONTEXT_MAX_TOKENS=8000

# AI Customization
AI_NAME=Aethelwyrd GM
AI_TONE=mysterious, immersive, high fantasy, cosmic horror undertones
TEMPERATURE=0.7

# TTS Narration (LocalAI /v1/audio/speech)
TTS_ENABLED=false
TTS_URL=http://172.31.25.75:8080
TTS_API_KEY=
TTS_MODEL=lfm2.5-audio-1.5b-realtime
TTS_NARRATOR_VOICE=fable
# TTS_ENGINE_HOST overrides the base URL returned in audio file links
# (useful when ai-engine is behind a LAN hostname or different port)
# Defaults to http://localhost:<ADMIN_PORT>
TTS_ENGINE_HOST=
TTS_VOLUME=0.8

# Arbitrary JavaScript execution in Foundry, reachable from player chat via the
# LLM and from POST /api/foundry/js. Off by default because a prompt-injected
# message could otherwise run destructive scripts against the world. The engine's
# own first-party Foundry calls (combat sync, initiative, scene setup) do not
# depend on this and work with it off.
ALLOW_EXECUTE_JS=false

# fvtt-world-cli — optional second command surface (typed, validated Foundry operations in the
# open GM session). Needs `npm i -g fvtt-world-cli`, its Foundry module paired once, and
# `fvtt-world-cli bridge serve` running on this machine. The protocol version must equal the
# installed release exactly. Read-only endpoints: /api/world-cli/status, /api/world-cli/audit-files
WORLD_CLI_ENABLED=false
WORLD_CLI_URL=ws://127.0.0.1:47833/
WORLD_CLI_PROTOCOL_VERSION=1.1.2
# Linux: ~/.config/fvtt-world-cli/config.json   macOS: ~/Library/Application Support/fvtt-world-cli/config.json
# (`fvtt-world-cli config get` prints the real path). A wrong path fails with NOT_CONFIGURED.
WORLD_CLI_CONFIG_PATH=~/.config/fvtt-world-cli/config.json
# World CLI was paired through the relay's localStorage seed, and the relay is gone. On the playwright
# backend it is not paired automatically yet, so the two switches below have no effect until it is paired
# by other means. Leave them off until then.
WORLD_CLI_WRITES_ENABLED=false
# Answer reads (actors, scenes, tokens, users, modules, canvas documents) through World CLI first.
WORLD_CLI_READS_ENABLED=false

# --- Pacing: time for the table to act (see config.py for details; 0 turns each off) ---
# Seconds of silence, counted from when the GM and its narration audio finish, before the GM's first nudge.
GM_IDLE_TIMEOUT=120
# Nudges with no reply before the GM waits quietly (0 = unlimited).
GM_MAX_UNANSWERED_NUDGES=2
# Combine messages from several players that arrive within this window into one GM turn (out of combat).
INPUT_BATCH_DEBOUNCE_SECONDS=6
# Combat: a PC's turn ends on "end turn"/"done" or this much silence after their last message.
COMBAT_PC_TURN_QUIET_SECONDS=8
# Combat: pause between turns, and how long a PC has to declare a reaction before an NPC attack on them lands.
COMBAT_TURN_GAP_SECONDS=3
COMBAT_REACTION_WINDOW_SECONDS=6

# --- Maps, portraits and Storyteller (see config.py) ---
# Inactive: the 2x detail pass is disabled (MPS deadlock), so maps are always 64 px/square.
MAP_HIRES_SCALE=2
MAP_HIRES_DENOISE=0.35
# Muted, earthy D&D palette (false restores the old wording/negative prompt) and the sampling CFG.
MAP_MUTED_PALETTE=true
MAP_CFG=5.0
# NPC portraits: auto = z-image turbo when ComfyUI has it (else SD 1.5); zimage / sd15 force one.
PORTRAIT_MODEL=auto
# Storyteller's Cinema: NPC lines and the prologue as subtitles. A no-op unless the module is active in the world.
CINEMA_ENABLED=true
CINEMA_SUBTITLES=true
# Establishing still (and optional ~4 s clip) per social scene at campaign build: slow, off by default.
CINEMA_ART_ENABLED=false
CINEMA_VIDEO_ENABLED=false
# A clip as the cinematic backdrop. It loads in Foundry, but playback was not confirmed in the headless GM session
# (it stayed on frame 0, which is the establishing still); keep off unless you have checked it on your clients.
CINEMA_VIDEO_BACKGROUNDS=false
