# LLM connection (any OpenAI-compatible endpoint: oMLX, OpenRouter, etc.)
LLM_API_KEY=your-llm-api-key-here
LLM_BASE_URL=http://localhost:8800/v1
MODEL=

# FoundryVTT Relay Connection
RELAY_URL=http://localhost:13010
RELAY_WS_URL=ws://localhost:13010/ws/api
# Leave empty when RELAY_MANAGED=true — the key is provisioned automatically
# and stored in data/relay/aigm-credentials.json
RELAY_API_KEY=

# Embedded Relay (launched automatically as a subprocess)
# Set to false to connect to an externally run relay instead
RELAY_MANAGED=true
RELAY_ADMIN_EMAIL=aigm@local.host
# Auto-generated and persisted to data/relay/aigm-credentials.json if empty
RELAY_ADMIN_PASSWORD=
RELAY_LOG_LEVEL=info
RELAY_ALLOW_HEADLESS=true
# Browser for headless Foundry sessions; auto-resolves Google Chrome if empty
RELAY_CHROME_PATH=
# macOS: launch Foundry automatically when the AI-GM starts. The manager only
# quits Foundry on shutdown if it was the process that launched it.
FOUNDRY_AUTO_START=true
FOUNDRY_SHUTDOWN_ON_EXIT=true
FOUNDRY_APP_PATH=/Applications/Foundry Virtual Tabletop.app
# Foundry display name of the human GM account. Optional fallback for /gm chat
# command authorization before the GM-role user list loads (role>=3 is always
# accepted regardless). Leave empty to rely on Foundry roles only.
FOUNDRY_USERNAME=
# Extra env vars for the relay subprocess (Stripe, SMTP, Redis, etc.):
# export them prefixed with RELAY_ENV_, e.g. RELAY_ENV_SMTP_HOST=smtp.example.com

# FoundryVTT credentials are managed exclusively in the relay dashboard/database.

# Admin Panel
ADMIN_PORT=18080
# Loopback-only by default. To expose the admin API on the LAN, set
# ADMIN_HOST=0.0.0.0 and set ADMIN_TOKEN (then store the same token in the
# admin panel's browser: localStorage key "aigm_admin_token").
ADMIN_HOST=127.0.0.1
ADMIN_TOKEN=
CORS_ORIGINS=http://localhost:18080,http://127.0.0.1:18080

# Database
SQLITE_DB=foundryvtt-ai-gm.db

# Campaign Data
CAMPAIGN_VAULT_PATH=~/Vaults/MyStuff/Dungeons_and_Dragons

# AI Customization
AI_NAME=Aethelwyrd GM
AI_TONE=mysterious, immersive, high fantasy, cosmic horror undertones
TEMPERATURE=0.7

# TTS Narration (LocalAI /v1/audio/speech)
TTS_ENABLED=false
TTS_URL=http://172.31.25.75:8080
TTS_API_KEY=
TTS_MODEL=lfm2.5-audio-1.5b-realtime
TTS_NARRATOR_VOICE=fable
# TTS_ENGINE_HOST overrides the base URL returned in audio file links
# (useful when ai-engine is behind a LAN hostname or different port)
# Defaults to http://localhost:<ADMIN_PORT>
TTS_ENGINE_HOST=
TTS_VOLUME=0.8
