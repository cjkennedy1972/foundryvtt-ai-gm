# LLM connection (any OpenAI-compatible endpoint: oMLX, OpenRouter, etc.)
LLM_API_KEY=your-llm-api-key-here
LLM_BASE_URL=http://localhost:8800/v1
MODEL=

# FoundryVTT Relay Connection
RELAY_URL=http://localhost:13010
RELAY_WS_URL=ws://localhost:13010/ws/api
# Leave empty when RELAY_MANAGED=true — the key is provisioned automatically
# and stored in data/relay/aigm-credentials.json
RELAY_API_KEY=

# Embedded Relay (launched automatically as a subprocess)
# Set to false to connect to an externally run relay instead
RELAY_MANAGED=true
RELAY_ADMIN_EMAIL=aigm@local.host
# Auto-generated and persisted to data/relay/aigm-credentials.json if empty
RELAY_ADMIN_PASSWORD=
RELAY_LOG_LEVEL=info
RELAY_ALLOW_HEADLESS=true
# Browser for headless Foundry sessions; auto-resolves Google Chrome if empty
RELAY_CHROME_PATH=
# macOS: launch Foundry automatically when the AI-GM starts. The manager only
# quits Foundry on shutdown if it was the process that launched it.
FOUNDRY_AUTO_START=true
FOUNDRY_SHUTDOWN_ON_EXIT=true
FOUNDRY_APP_PATH=/Applications/Foundry Virtual Tabletop.app
# Foundry display name of the human operator. The /gm commands can be issued by:
# 1. Any Foundry user with role >= 3 (the classic path), OR
# 2. A player-role user whose display name matches this value (operator fallback).
# This fallback is accepted before the GM-role user list loads. In self-hosted
# deployments, the operator owns the Foundry world and controls all usernames.
# Leave empty to require role >= 3 for all /gm commands.
FOUNDRY_USERNAME=
# Extra env vars for the relay subprocess (Stripe, SMTP, Redis, etc.):
# export them prefixed with RELAY_ENV_, e.g. RELAY_ENV_SMTP_HOST=smtp.example.com

# FoundryVTT credentials are managed exclusively in the relay dashboard/database.

# Admin Panel
ADMIN_PORT=18080
# Loopback-only by default. To expose the admin API on the LAN, set
# ADMIN_HOST=0.0.0.0 and set ADMIN_TOKEN (then store the same token in the
# admin panel's browser: localStorage key "aigm_admin_token").
ADMIN_HOST=127.0.0.1
ADMIN_TOKEN=
# Add your Foundry origin (scheme://host:port of the page the GM opens) so the in-Foundry
# control panel module can reach this engine, e.g. ...,http://localhost:30000
CORS_ORIGINS=http://localhost:18080,http://127.0.0.1:18080

# Database
SQLITE_DB=foundryvtt-ai-gm.db

# Campaign Data
CAMPAIGN_VAULT_PATH=~/Vaults/MyStuff/Dungeons_and_Dragons

# Folders a source path for campaign lore enrichment may be under (JSON list, ~ expanded).
# Default is your home folder; add others (e.g. an external drive) to enrich from them.
# SOURCE_ROOTS=["~", "/Volumes/Books"]

# How much of the campaign's Worldbuilding note rides in every turn's system prompt;
# the rest, and everything enrichment appends, is retrieved when relevant.
# WORLD_CONTEXT_MAX_TOKENS=6000
# Ceiling on one turn's added context (location, characters in play, memory, lore, maps);
# over it the lowest-priority blocks are dropped and logged.
# TURN_CONTEXT_MAX_TOKENS=8000

# AI Customization
AI_NAME=Aethelwyrd GM
AI_TONE=mysterious, immersive, high fantasy, cosmic horror undertones
TEMPERATURE=0.7

# TTS Narration (LocalAI /v1/audio/speech)
TTS_ENABLED=false
TTS_URL=http://172.31.25.75:8080
TTS_API_KEY=
TTS_MODEL=lfm2.5-audio-1.5b-realtime
TTS_NARRATOR_VOICE=fable
# TTS_ENGINE_HOST overrides the base URL returned in audio file links
# (useful when ai-engine is behind a LAN hostname or different port)
# Defaults to http://localhost:<ADMIN_PORT>
TTS_ENGINE_HOST=
TTS_VOLUME=0.8

# Arbitrary JavaScript execution in Foundry, reachable from player chat via the
# LLM and from POST /api/foundry/js. Off by default because a prompt-injected
# message could otherwise run destructive scripts against the world. The engine's
# own first-party Foundry calls (combat sync, initiative, scene setup) do not
# depend on this and work with it off.
ALLOW_EXECUTE_JS=false

# fvtt-world-cli — optional second command surface (typed, validated Foundry operations in the
# open GM session). Needs `npm i -g fvtt-world-cli`, its Foundry module paired once, and
# `fvtt-world-cli bridge serve` running on this machine. The protocol version must equal the
# installed release exactly. Read-only endpoints: /api/world-cli/status, /api/world-cli/audit-files
WORLD_CLI_ENABLED=false
# Pair once with POST /api/world-cli/pair (needs the engine connected to a Foundry world and the daemon
# running). It presses Pair in the engine's own GM session, approves only its own request, and returns an
# `export RELAY_ENV_HEADLESS_LOCALSTORAGE_SEED=...` line: put it in start.sh next to the other
# RELAY_ENV_ exports and restart the relay, so every headless session starts already paired.
WORLD_CLI_URL=ws://127.0.0.1:47833/
WORLD_CLI_PROTOCOL_VERSION=1.1.2
WORLD_CLI_CONFIG_PATH=~/.config/fvtt-world-cli/config.json
# Route scene placeables (walls, lights, sounds) through World CLI; the relay stays the fallback.
# Clearing existing ones uses scene.<kind>.delete-many, which is approval-gated by default (the relay
# then handles it as before). To allow it unattended, add the key `fvtt-world-cli.commandPolicy` to the
# relay's HEADLESS_LOCALSTORAGE_SEED for your Foundry origin, with the JSON text
# {"version":1,"overrides":{"scene.wall.delete-many":"allow","scene.light.delete-many":"allow","scene.sound.delete-many":"allow"}}
# (the relay's execute-js refuses to set it, and a wrongly shaped policy is silently discarded).
# end_encounter uses combat.delete, also approval-gated: until it is allowed the same way
# ("combat.delete":"allow" in the overrides) the relay ends the encounter. Same mechanism as the
# entries above, but not yet exercised against a live Foundry for this command.
WORLD_CLI_WRITES_ENABLED=false
# Answer FoundryClient's reads (actors, scenes, tokens, users, modules, canvas documents) through World CLI
# first; anything it cannot answer falls back to the relay. Needs WORLD_CLI_ENABLED.
WORLD_CLI_READS_ENABLED=false
