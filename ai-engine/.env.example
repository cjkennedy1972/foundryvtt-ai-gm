# LLM connection (any OpenAI-compatible endpoint: oMLX, OpenRouter, etc.)
LLM_API_KEY=your-llm-api-key-here
LLM_BASE_URL=http://localhost:18800/v1
MODEL=

# FoundryVTT Relay Connection
RELAY_URL=http://localhost:13010
RELAY_WS_URL=ws://localhost:13010/ws/api
RELAY_API_KEY=your-relay-api-key-here

# Admin Panel
ADMIN_PORT=18080

# Database
SQLITE_DB=foundryvtt-ai-gm.db

# Campaign Data
CAMPAIGN_VAULT_PATH=~/Vaults/MyStuff/games/Dungeons_and_Dragons

# AI Customization
AI_NAME=Aethelwyrd GM
AI_TONE=mysterious, immersive, high fantasy, cosmic horror undertones
TEMPERATURE=0.7
