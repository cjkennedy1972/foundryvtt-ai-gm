# LLM connection (any OpenAI-compatible endpoint: oMLX, OpenRouter, etc.)
LLM_API_KEY=omlx-1jti350lx0u3q5dl
LLM_BASE_URL=http://localhost:8800/v1
MODEL=Qwen3.6-35B-A3B-4bit

# FoundryVTT Relay Connection
RELAY_URL=http://localhost:13010
RELAY_WS_URL=ws://localhost:13010/ws/api
# Leave empty when RELAY_MANAGED=true — the key is provisioned automatically
# and stored in data/relay/aigm-credentials.json
RELAY_API_KEY=

# Embedded Relay (launched automatically as a subprocess)
# Set to false to connect to an externally run relay instead
RELAY_MANAGED=true
RELAY_ADMIN_EMAIL=aigm@local.host
# Auto-generated and persisted to data/relay/aigm-credentials.json if empty
RELAY_ADMIN_PASSWORD=
RELAY_LOG_LEVEL=info
RELAY_ALLOW_HEADLESS=true
# Browser for headless Foundry sessions; auto-resolves Google Chrome if empty
RELAY_CHROME_PATH=
# Extra env vars for the relay subprocess (Stripe, SMTP, Redis, etc.):
# export them prefixed with RELAY_ENV_, e.g. RELAY_ENV_SMTP_HOST=smtp.example.com

# FoundryVTT (used by relay for headless Chrome session — replaces manual module pairing)
FOUNDRY_URL=http://localhost:30000
FOUNDRY_USERNAME=AI-GM
FOUNDRY_PASSWORD=5ef9d1254c8a327d2433d7936e5539ac

# Admin Panel
ADMIN_PORT=18080

# Database
SQLITE_DB=foundryvtt-ai-gm.db

# Campaign Data
CAMPAIGN_VAULT_PATH=~/Vaults/MyStuff/Dungeons_and_Dragons

# GM Pacing
GM_IDLE_TIMEOUT=45

# AI Customization
AI_NAME=Awyrd GM
AI_TONE=mysterious, immersive, high fantasy, cosmic horror undertones
TEMPERATURE=0.7

# TTS Narration — local neural TTS via oMLX (/v1/audio/speech)
TTS_ENABLED=true
TTS_ENGINE=server
TTS_URL=http://localhost:8800
TTS_API_KEY=omlx-1jti350lx0u3q5dl
TTS_MODEL=Voxtral-4B-TTS-2603-mlx-4bit
TTS_NARRATOR_VOICE=neutral_male
TTS_VOICE_MAP=onyx:neutral_male,fable:casual_male,echo:casual_male,nova:neutral_female,shimmer:cheerful_female,alloy:casual_female
TTS_VOICE_MALE=neutral_male
TTS_VOICE_FEMALE=neutral_female
TTS_ALLOWED_VOICES=casual_female,casual_male,cheerful_female,neutral_female,neutral_male
TTS_FORMAT=wav
TTS_ENGINE_HOST=http://localhost:18080
TTS_VOLUME=0.8

